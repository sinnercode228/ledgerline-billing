{
  "name": "ledgerline-billing",
  "version": "0.1.0",
  "private": true,
  "description": "Ledgerline: subscription billing with proration, gapless invoice numbers, a double-entry ledger and dunning.",
  "license": "MIT",
  "author": "sinnercode228",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.check.json",
    "test": "vitest run",
    "build": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "migrate": "node --env-file-if-exists=.env server/dist/cli/migrate.js",
    "seed": "node --env-file-if-exists=.env server/dist/cli/seed.js",
    "serve": "node --env-file-if-exists=.env server/dist/cli/serve.js",
    "worker": "node --env-file-if-exists=.env server/dist/cli/worker.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "vite": "~7.3.7"
  }
}
