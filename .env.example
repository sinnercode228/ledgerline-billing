# Copy to .env and fill in. The npm scripts and docker compose read it.

# PostgreSQL connection string.
LEDGERLINE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerline_dev

# Bearer key for every /v1 route: at least 32 random characters (openssl rand -hex 32).
LEDGERLINE_API_KEY=

# Payrail webhook signing secret. While rotating, list the new and the old one: new,old
LEDGERLINE_WEBHOOK_SECRET=

# Browser origins allowed to call the API, comma-separated, such as where the dashboard runs.
LEDGERLINE_CORS_ORIGINS=http://localhost:5173

LEDGERLINE_HOST=0.0.0.0
LEDGERLINE_PORT=3000
LEDGERLINE_LOG_LEVEL=info

# 1 keeps "now" in the database and enables POST /v1/test-clock/advance. Off in production.
LEDGERLINE_TEST_CLOCK=0

# Days after the first failed payment on which an unpaid invoice is retried.
LEDGERLINE_DUNNING_RETRY_DAYS=1,3,5

# Where the bundled fake Payrail posts its signed webhooks. Leave empty to apply results in-process only.
LEDGERLINE_PAYRAIL_WEBHOOK_URL=http://localhost:3000/webhooks/payrail

# 1 allows a missing or weak API key and webhook secret for local work. Never in production.
LEDGERLINE_DEV=0

# Integration tests create a schema per test in this database; they are skipped when it is unset.
LEDGERLINE_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerline_test
